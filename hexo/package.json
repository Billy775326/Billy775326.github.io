{
  "name": "billy-blog-source",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "hexo clean && hexo generate && python bin/finalize.py && python bin/verify.py",
    "server": "npm run build && python -m http.server 4000 --bind 127.0.0.1 --directory public",
    "new": "hexo new",
    "preview": "npm run build && python -m http.server 4000 --bind 127.0.0.1 --directory public",
    "release": "npm run build && python bin/release.py",
    "verify": "python bin/verify.py"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-butterfly": "5.7.0",
    "hexo-wordcount": "6.0.1"
  }
}
